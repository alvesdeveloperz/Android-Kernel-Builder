[
  {
    "kernelSource": {
      "name": "android_kernel_xiaomi_sdm710",
      "repo": "https://github.com/LineageOS/android_kernel_xiaomi_sdm710",
      "branch": "lineage-22.2",
      "device": "pyxis",
      "defconfig": "xiaomi/sdm710-common.config xiaomi/pyxis.config"
    },
    "withKernelSU": true,
    "toolchains": [
      {
        "repo": "https://gitlab.com/clangsantoni/zyc_clang",
        "branch": "14",
        "name": "zyc_clang",
        "binPath": ["bin"]
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CC": "zyc_clang/bin/clang",
      "externalCommand": {
        "CROSS_COMPILE": "zyc_clang/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "zyc_clang/bin/arm-linux-gnueabi-",
        "LD": "zyc_clang/bin/ld.lld",
        "AR": "zyc_clang/bin/llvm-ar",
        "NM": "zyc_clang/bin/llvm-nm",
        "OBJCOPY": "zyc_clang/bin/llvm-objcopy",
        "OBJDUMP": "zyc_clang/bin/llvm-objdump",
        "STRIP": "zyc_clang/bin/llvm-strip"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/Akitlove/AnyKernel3",
      "branch": "master"
    }
  }
]
